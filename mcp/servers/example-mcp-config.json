{
  "mcpServers": {
    "example-filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/path/to/allowed/directory"
      ],
      "description": "Example MCP filesystem server configuration"
    },
    "example-github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_TOKEN": "your-github-token-here"
      },
      "description": "Example MCP GitHub server configuration"
    }
  }
}
